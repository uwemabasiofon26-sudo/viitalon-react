# Copy this file to .env.local for local development (never commit .env.local).
# In production, set these in Vercel: Project Settings -> Environment Variables.

STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret-here
RESEND_API_KEY=your-resend-api-key-here
RESEND_AUDIENCE_ID=your-resend-audience-id-here
ORDER_NOTIFICATION_EMAIL=info@viitalon.com
SUPPLIER_NOTIFICATION_EMAIL=sales@edh.nz
ORDER_NOTIFICATION_FROM=orders@viitalon.com
SITE_URL=https://viitalon.com

# Optional — real Stripe Shipping Rate IDs (Stripe Dashboard -> Settings ->
# Shipping). When both are set, checkout automatically shows the matching
# rate based on the customer's shipping address: free within New Zealand,
# NZ$40 for international orders. If left unset, checkout falls back to a
# single flat free-shipping option for everyone.
STRIPE_SHIPPING_RATE_NZ=your-nz-shipping-rate-id-here
STRIPE_SHIPPING_RATE_INTL=your-international-shipping-rate-id-here
