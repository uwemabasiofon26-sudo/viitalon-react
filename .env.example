# Copy this file to .env.local for local development (never commit .env.local).
# In production, set these in Vercel: Project Settings -> Environment Variables.

# Stripe secret key (starts with sk_test_... or sk_live_...)
# Found in the Stripe Dashboard -> Developers -> API keys.
# NEVER commit the real value to Git or paste it into a chat/AI tool.
SSTRIPE_SECRET_KEY=your-stripe-secret-key-here

# Stripe webhook signing secret (starts with whsec_...)
# Created when you add a webhook endpoint in the Stripe Dashboard
# pointing at https://yourdomain.com/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Resend API key (from resend.com) — used to send the merchant
# "new order" notification email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where new-order notifications are sent (defaults to info@viitalon.com)
ORDER_NOTIFICATION_EMAIL=info@viitalon.com

# The "from" address for notification emails. Must be on a domain
# you've verified in Resend (defaults to orders@viitalon.com)
ORDER_NOTIFICATION_FROM=orders@viitalon.com

# Your live site URL, used for links inside the customer confirmation
# email (defaults to https://viitalon.com)
SITE_URL=https://viitalon.com
